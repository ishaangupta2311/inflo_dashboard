# Clerk (development keys live in .env.local; production keys go in the host env)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase Postgres
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime via the Prisma driver adapter.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma CLI for migrations.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Realtime (live order updates). From Supabase dashboard → Project Settings → API.
# Without these, order pages fall back to short-interval polling.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

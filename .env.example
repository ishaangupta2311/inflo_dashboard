# Clerk (development keys live in .env.local; production keys go in the host env)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase Postgres
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime via the Prisma driver adapter.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma CLI for migrations.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Resend transactional email. Without RESEND_API_KEY the senders no-op (the app
# still builds/runs). NOTE: Resend's sandbox from-address (onboarding@resend.dev)
# only delivers to your own Resend account email — verify a domain and set
# EMAIL_FROM to an address on it for client emails to actually send.
RESEND_API_KEY=
EMAIL_FROM="Influencer Outreach <onboarding@resend.dev>"
# Absolute base URL used for links in emails (no trailing slash).
APP_URL="http://localhost:3001"

# PayPal Online Checkout. Leave both blank to keep the free "place order, pay
# later" flow. Paste your PayPal app's API credentials below and the cart
# switches to "Pay with PayPal" — orders are only created after a successful
# capture. No code changes needed; this is the only thing to set.
#   PAYPAL_ENV: "sandbox" (test money) or "live" (real money). Defaults to sandbox.
#   The client id is public (loaded by the browser SDK); keep the secret server-side.
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
